# ============================================================
# ONE MORE — environment configuration
# Copy this file to `.env` and fill in your real Stripe keys.
# ============================================================

# ---- Server ----
PORT=3000

# ---- Admin account (recommended for production) ----
# If BOTH are set, the server ensures an admin user with these credentials
# exists on every boot (creating it, or updating the password if it exists).
# If left blank, the server falls back to seeding a random `admin` password
# once on first boot and printing it to the console.
# NEVER commit real values — set these in your hosting provider's env settings.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Stripe (required for payments) ----
# Test keys start with sk_test_ / whsec_ / price_
# Get them at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Either set STRIPE_PRICE_ID (recommended: pre-created Price in Stripe Dashboard)
# OR leave it blank and set EXAM_PRICE_CENTS + EXAM_PRICE_CURRENCY below to
# create ad-hoc line items each time.
STRIPE_PRICE_ID=

# Fallback ad-hoc pricing (used only if STRIPE_PRICE_ID is blank).
EXAM_PRICE_CENTS=9900
EXAM_PRICE_CURRENCY=usd
EXAM_PRICE_LABEL=ONE MORE — Full Exam Simulator Access

# Public URL where Stripe will redirect after checkout (success / cancel)
PUBLIC_BASE_URL=http://localhost:3000

# ---- Local webhook testing ----
# In a second terminal, run:
#   stripe listen --forward-to http://localhost:3000/api/webhook/stripe
# Stripe CLI will print a `whsec_...` value — paste it into STRIPE_WEBHOOK_SECRET above.
